# Origen público de los medios. Opcional: src/lib/assets.ts ya trae la URL del
# bucket por defecto. Defínela vacía para servir desde public/ y trabajar sin red.
# PUBLIC_MEDIA_BASE_URL=

# Credenciales de R2. Solo las necesita `npm run media:sync`, nunca el build.
# Sin ellas puedes publicar dejando archivos en media-inbox/ y haciendo push.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=simplixity-media
