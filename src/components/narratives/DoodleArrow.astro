---
interface Props {
  variant?: "hook" | "down" | "left" | "right";
  class?: string;
}

const { variant = "down", class: className = "" } = Astro.props;
---

{variant === "hook" ? (
  <svg class:list={["doodle-arrow", "doodle-arrow--hook", className]} viewBox="0 0 58 56" width="42" height="40" aria-hidden="true">
    <path d="M5 10C16 4 32 4 38 13c6 9 2 21 0 29" />
    <path class="doodle-arrow__echo" d="M7 12c10-5 24-4 29 3 5 8 1 18 0 25" />
    <path d="m28 34 10 10 11-11" />
  </svg>
) : variant === "down" ? (
  <svg class:list={["doodle-arrow", "doodle-arrow--down", className]} viewBox="0 0 48 58" width="28" height="34" aria-hidden="true">
    <path d="M25 4c-7 7 5 12-1 19-5 6 5 10 1 19" />
    <path class="doodle-arrow__echo" d="M28 7c-5 6 4 11-1 17" />
    <path d="m15 34 10 12 11-13" />
    <path class="doodle-arrow__echo" d="m18 35 7 8 8-9" />
  </svg>
) : (
  <svg class:list={["doodle-arrow", "doodle-arrow--side", className]} viewBox="0 0 64 34" width="48" height="28" aria-hidden="true">
    <g transform={variant === "left" ? "translate(64 0) scale(-1 1)" : undefined}>
      <path d="M5 18c12-3 20 2 31-1 7-2 12-1 21 0" />
      <path class="doodle-arrow__echo" d="M8 21c11-2 19 1 29-1 8-2 13-1 18 0" />
      <path d="m47 9 11 8-10 9" />
    </g>
  </svg>
)}

<style>
  .doodle-arrow {
    display: inline-block;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .doodle-arrow__echo {
    opacity: .42;
    stroke-width: 1.35;
  }

  .doodle-arrow--hook {
    width: 1.05em;
    height: 1em;
    flex: none;
  }

  .doodle-arrow--down {
    width: 1.35em;
    height: 1.7em;
  }

  .doodle-arrow--side {
    width: 1.65em;
    height: 1em;
  }
</style>
