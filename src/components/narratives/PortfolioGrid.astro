---
import { projects } from "../../data/site";
import DoodleArrow from "./DoodleArrow.astro";
---

<section
  id="portafolios"
  class="portfolio-intro story-panel z-[3] flex flex-col justify-between bg-navy px-[var(--section-inline)] py-[var(--section-block)] text-white"
  data-tone="solid"
  aria-labelledby="portfolio-title"
>
  <div class="halftone-light opacity-[.12]"></div>
  <p class="portfolio-kicker relative m-0 text-cyan">archivo / 04 bitácoras</p>
  <h2 id="portfolio-title" class="font-display relative m-0 max-w-[11ch] text-[clamp(54px,8.6vw,142px)] leading-[.82]" data-title-reveal>
    Cuatro formas<br /><span class="text-yellow">de mirar.</span>
  </h2>
  <div class="relative flex flex-wrap items-end justify-between gap-6">
    <p class="m-0 max-w-[43ch] text-[clamp(16px,1.6vw,20px)] leading-normal text-muted">
      Baja para recorrer cada proyecto. Cada cubierta abre una bitácora completa con decisiones, proceso, imágenes y sonido.
    </p>
    <p class="scroll-note m-0 text-yellow">seguir bajando ↓</p>
  </div>
</section>

{projects.map((project, index) => (
  <section
    class="portfolio-story story-panel grid content-center items-center gap-[clamp(30px,6vw,96px)] px-[var(--section-inline)] py-[var(--section-block)] lg:grid-cols-[.8fr_1.2fr]"
    style={`--story-bg:${project.bg};--story-fg:${project.fg};--story-accent:${project.accent};z-index:${index + 4}`}
    data-tone="solid"
    aria-labelledby={`project-title-${index}`}
  >
    <div class="halftone-light opacity-[.18]"></div>

    <div class="story-copy relative z-[1]">
      <p class="story-number m-0">bitácora {String(index + 1).padStart(2, "0")} / {String(projects.length).padStart(2, "0")}</p>
      <h2 id={`project-title-${index}`} class="font-display m-[clamp(14px,2.2vh,24px)_0_0] text-[clamp(52px,7vw,116px)] leading-[.82]" data-title-reveal>
        {project.title}
      </h2>
      <p class="story-note mt-[clamp(22px,4vh,42px)] mb-0 max-w-[42ch] text-[clamp(15px,1.5vw,19px)] leading-normal">
        {project.note}
      </p>
      <div class="mt-6 flex flex-wrap gap-2.5">
        {project.tags.map((tag) => <span class="story-tag">{tag}</span>)}
      </div>
    </div>

    <a
      href="#bitacora"
      class="notebook-launch relative z-[1] justify-self-center"
      data-open-project={index}
      aria-label={`Abrir la bitácora ${project.title}`}
    >
      <span class="notebook-tape" aria-hidden="true"></span>
      <div class="notebook-cover">
        {project.cover ? (
          <img
            src={project.cover}
            alt={`Portada de ${project.title}`}
            width="884"
            height="1117"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />
        ) : (
          <div class="empty-cover" aria-hidden="true">
            <span class="empty-cover__index">{String(index + 1).padStart(2, "0")}</span>
            <strong>{project.word}</strong>
            <span>archivo por montar</span>
          </div>
        )}
      </div>
      <div class="notebook-action">
        <span>Abrir bitácora</span>
        <DoodleArrow variant="right" class="launch-arrow" />
      </div>
    </a>
  </section>
))}

<style>
  .portfolio-kicker,
  .scroll-note,
  .story-number,
  .story-tag,
  .notebook-action,
  .empty-cover { font-family: var(--font-hand); }

  .portfolio-kicker { font-size: clamp(17px, 1.5vw, 23px); rotate: -1deg; }
  .scroll-note { font-size: clamp(18px, 1.7vw, 26px); rotate: 2deg; }

  .portfolio-story {
    color: var(--story-fg);
    background-color: var(--story-bg);
    overflow: hidden;
  }

  .story-number { font-size: clamp(18px, 1.8vw, 27px); rotate: -1.5deg; }
  .story-note { color: color-mix(in srgb, var(--story-fg) 82%, transparent); font-weight: 560; }
  .story-tag {
    display: inline-flex;
    border: 1.5px solid currentColor;
    border-radius: 48% 52% 44% 56% / 52% 46% 54% 48%;
    padding: .45rem .85rem;
    font-size: 14px;
    rotate: -1deg;
  }
  .story-tag:nth-child(even) { rotate: 2deg; }

  .notebook-launch {
    display: block;
    width: min(50vw, 650px);
    color: #0e2a47;
    transition: transform 420ms cubic-bezier(.16,1,.3,1);
  }
  .notebook-launch:hover { transform: translateY(-10px) rotate(.5deg); }
  .notebook-launch:focus-visible { outline-color: color-mix(in srgb, var(--story-fg) 82%, #ffc107); }
  .notebook-cover {
    position: relative;
    height: min(62vh, 610px);
    overflow: hidden;
    border: 2px solid rgb(14 42 71 / .72);
    border-radius: 8px 13px 9px 6px;
    background: #f8f4e9;
    box-shadow: 10px 14px 0 rgb(14 42 71 / .14), 0 24px 44px rgb(14 42 71 / .2);
    rotate: -1deg;
  }
  .notebook-cover::after { content: ""; position: absolute; inset: 7px -5px -5px 6px; border: 1px solid rgb(14 42 71 / .34); border-radius: 12px 7px 11px 8px; pointer-events: none; }
  .notebook-cover img { width: 100%; height: 100%; object-fit: cover; }
  .notebook-tape { position: absolute; top: -12px; left: 50%; z-index: 3; width: 25%; height: 27px; translate: -50% 0; rotate: 2deg; background: rgb(255 239 184 / .82); }

  .empty-cover {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: clamp(24px, 4vw, 52px);
    background-image:
      radial-gradient(rgb(14 42 71 / .06) .7px, transparent .8px),
      repeating-linear-gradient(0deg, transparent 0 36px, rgb(42 108 152 / .08) 36px 37px);
    background-size: 8px 8px, 100% 37px;
  }
  .empty-cover strong { margin-block: auto; color: var(--story-accent); font-size: clamp(48px, 7vw, 108px); font-weight: 400; line-height: .82; text-align: center; rotate: -2deg; }
  .empty-cover > span { font-size: clamp(16px, 1.5vw, 22px); }
  .empty-cover__index { align-self: flex-end; color: rgb(14 42 71 / .55); }

  .notebook-action {
    display: flex;
    width: max-content;
    align-items: center;
    gap: .65rem;
    margin: 20px auto 0;
    border: 2px solid #0e2a47;
    border-radius: 48% 52% 45% 55% / 54% 46% 55% 45%;
    background: #fff8e8;
    padding: .65rem 1rem .55rem 1.15rem;
    font-size: clamp(17px, 1.6vw, 23px);
    box-shadow: 3px 4px 0 rgb(14 42 71 / .12);
    rotate: 1deg;
  }
  :global(.launch-arrow) { width: 35px; }

  @media (max-width: 1023px) {
    .portfolio-story { grid-template-columns: 1fr 1.1fr; }
    .notebook-launch { width: min(52vw, 560px); }
    .notebook-cover { height: min(55vh, 520px); }
  }

  @media (max-width: 767px) {
    .portfolio-intro { min-height: 100svh; padding-top: 6.5rem; padding-bottom: 3rem; }
    .portfolio-story { grid-template-columns: 1fr; align-content: start; gap: 24px; padding-top: 6.5rem; padding-bottom: 2.5rem; }
    .story-copy h2 { font-size: clamp(44px, 14vw, 72px); }
    .story-note { margin-top: 16px; font-size: 14px; }
    .story-copy .story-tag { font-size: 12px; }
    .notebook-launch { width: min(82vw, 440px); }
    .notebook-cover { height: min(48vh, 420px); }
    .notebook-action { margin-top: 14px; }
  }
</style>
