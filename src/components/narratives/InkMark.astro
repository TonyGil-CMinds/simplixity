---
type Variant =
  | "underline"
  | "underline-double"
  | "circle"
  | "box"
  | "bracket"
  | "star"
  | "squiggle"
  | "check"
  | "corner"
  | "connector";

interface Props {
  variant: Variant;
  class?: string;
  width?: number;
}

const { variant, class: className = "", width = 2.6 } = Astro.props;
const stretch = variant !== "star" && variant !== "check" && variant !== "corner";
const common = {
  class: `ink-mark ink-mark--${variant} ${className}`.trim(),
  "stroke-width": String(width),
  "aria-hidden": true as const,
  ...(stretch ? { preserveAspectRatio: "none" } : {}),
};
---

{variant === "underline" ? (
  <svg {...common} viewBox="0 0 200 12">
    <path d="M3 6.4c26-2.6 52-3.4 78-2.9 26 .5 52 2.2 78 4.1" vector-effect="non-scaling-stroke" />
  </svg>
) : variant === "underline-double" ? (
  <svg {...common} viewBox="0 0 200 18">
    <path d="M4 6c28-2.9 55-3.7 82-3.1 25 .6 49 2.1 74 4.4" vector-effect="non-scaling-stroke" />
    <path class="ink-mark__echo" d="M9 13.6c30-2.2 58-2.6 84-1.9 22 .6 43 1.6 65 3" vector-effect="non-scaling-stroke" />
  </svg>
) : variant === "circle" ? (
  <svg {...common} viewBox="0 0 200 92">
    <path d="M104 5.5C56 3 12 17 8 45c-4 27 39 43 92 42 48-1 92-16 92-41 0-24-38-40-88-40.5" vector-effect="non-scaling-stroke" />
    <path class="ink-mark__echo" d="M188 26c8 20-24 40-78 41" vector-effect="non-scaling-stroke" />
  </svg>
) : variant === "box" ? (
  <svg {...common} viewBox="0 0 200 92">
    <path d="M7 9c56-3 118-4 186-2M193 4c3 26 3 54 1 82M197 82c-58 4-124 5-188 2M11 87C7 61 6 33 8 6" vector-effect="non-scaling-stroke" />
  </svg>
) : variant === "bracket" ? (
  <svg {...common} viewBox="0 0 20 200">
    <path d="M16 4C8 8 6 18 6.5 34c.5 18 1 42-3.5 64 5 20 4.5 46 4 66-.5 16 1.5 28 9 32" vector-effect="non-scaling-stroke" />
  </svg>
) : variant === "star" ? (
  <svg {...common} viewBox="0 0 48 48">
    <path d="M24 4c-1.4 12-1.8 28-1 40" vector-effect="non-scaling-stroke" />
    <path d="M6 14c11 6 25 13 36 19" vector-effect="non-scaling-stroke" />
    <path d="M42 14c-11 6-25 13-36 19" vector-effect="non-scaling-stroke" />
  </svg>
) : variant === "squiggle" ? (
  <svg {...common} viewBox="0 0 200 14">
    <path d="M3 8c14-9 25 5 39 3 14-2 22-10 36-6 14 5 22 8 36 3 14-4 24-8 38-2 8 3 15 4 25 2" vector-effect="non-scaling-stroke" />
  </svg>
) : variant === "check" ? (
  <svg {...common} viewBox="0 0 40 34">
    <path d="M4 17c4 2 8 6 11 12C20 17 27 8 36 3" vector-effect="non-scaling-stroke" />
  </svg>
) : variant === "corner" ? (
  <svg {...common} viewBox="0 0 60 60">
    <path d="M4 56C3 36 4 18 8 5c14-3 30-3 48-1" vector-effect="non-scaling-stroke" />
    <path class="ink-mark__echo" d="M10 54c-1-17 0-32 3-43 12-2 26-2 41-1" vector-effect="non-scaling-stroke" />
  </svg>
) : (
  <svg {...common} viewBox="0 0 12 200">
    <path d="M6 3c-2 26-3 52-2 76 1 26 2 52 1 78-1 14-1 27 1 40" vector-effect="non-scaling-stroke" />
  </svg>
)}
