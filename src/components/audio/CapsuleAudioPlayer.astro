---
import type { SoundtrackTrack } from "../../data/narratives";

interface Props {
  track: SoundtrackTrack;
  class?: string;
}

const { track, class: className = "" } = Astro.props;
---

<section
  class:list={["capsule-player", className]}
  data-audio-player
  data-audio-src={track.src}
  data-audio-title={track.title}
  data-audio-artist="Tech4Nature, Banda Sonora Original"
>
  <span class="capsule-player__tape" aria-hidden="true"></span>
  <img src="/media/narratives/tech-for-nature/images/soundtrack-cover.webp" alt="Portada de la banda sonora de Tech for Nature México" />
  <div class="capsule-player__copy">
    <h3>{track.title}</h3>
    <p>apunte sonoro · Tech4Nature</p>
  </div>
  <button type="button" class="capsule-player__toggle" data-audio-toggle aria-label={`Reproducir ${track.title}`} aria-pressed="false">
    <svg class="capsule-icon capsule-icon--play" viewBox="0 0 48 48" aria-hidden="true"><path d="M17 12.8v22.4c0 1.7 1.9 2.7 3.3 1.8l17-11.2a2.1 2.1 0 0 0 0-3.6l-17-11.2c-1.4-.9-3.3.1-3.3 1.8Z" /></svg>
    <svg class="capsule-icon capsule-icon--pause" viewBox="0 0 48 48" aria-hidden="true"><rect x="13" y="10" width="8" height="28" rx="4"/><rect x="27" y="10" width="8" height="28" rx="4"/></svg>
  </button>
  <input
    class="capsule-player__progress"
    type="range"
    min="0"
    max="1000"
    value="0"
    aria-label={`Posición de ${track.title}`}
    data-audio-progress
  />
</section>

<style>
  .capsule-player {
    --audio-progress: 0%;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(8px, 3cqw, 18px);
    overflow: visible;
    border: 2px solid rgb(14 42 71 / .64);
    border-radius: 8px 13px 10px 7px;
    background-color: #fff9e8;
    background-image: radial-gradient(rgb(14 42 71 / .045) .6px, transparent .8px);
    background-size: 7px 7px;
    color: #0e2a47;
    padding: clamp(8px, 2.8cqw, 15px) clamp(10px, 3cqw, 18px) 18px;
    box-shadow: 5px 7px 0 rgb(14 42 71 / .08), 0 13px 28px rgb(14 42 71 / .15);
    transform: rotate(.45deg);
  }

  .capsule-player::after { content: ""; position: absolute; inset: 4px -4px -4px 4px; z-index: -1; border: 1px solid rgb(14 42 71 / .36); border-radius: 11px 7px 13px 8px; rotate: -.6deg; }
  .capsule-player__tape { position: absolute; top: -9px; left: 12%; width: 18%; height: 17px; rotate: -4deg; background: rgb(255 226 132 / .72); }

  img { width: clamp(38px, 11cqw, 68px); aspect-ratio: 1; border: 1px solid rgb(14 42 71 / .48); border-radius: 3px; object-fit: cover; rotate: -2deg; }
  h3 { margin: 0; color: #090b0d; font-family: var(--font-hand); font-size: clamp(15px, 4.8cqw, 25px); font-weight: 400; line-height: 1; }
  p { margin: 4px 0 0; color: #526775; font-family: var(--font-hand); font-size: clamp(8px, 2.2cqw, 11px); }

  .capsule-player__toggle {
    display: grid;
    width: clamp(38px, 11cqw, 62px);
    height: clamp(38px, 11cqw, 62px);
    place-items: center;
    position: relative;
    border: 2px solid #0e2a47;
    border-radius: 49% 51% 44% 56% / 54% 45% 55% 46%;
    background: #ffe5a0;
    color: #0e2a47;
    box-shadow: none;
    cursor: pointer;
    transition: transform 240ms cubic-bezier(.16,1,.3,1), border-radius 300ms cubic-bezier(.16,1,.3,1), background 180ms ease;
  }
  .capsule-player__toggle::after { content: ""; position: absolute; inset: 3px -3px -3px 3px; border: 1px solid currentColor; border-radius: 53% 47% 57% 43%; opacity: .45; rotate: -6deg; }
  .capsule-player__toggle:hover { transform: scale(1.06) rotate(3deg); background: #ffc107; }
  [data-playing="true"] .capsule-player__toggle { border-radius: 46% 54% 51% 49%; background: #0e2a47; color: #ffc107; }

  .capsule-icon { width: 70%; height: 70%; fill: currentColor; }
  .capsule-icon--play { display: block; }
  .capsule-icon--pause { display: none; }
  [data-playing="true"] .capsule-icon--play { display: none; }
  [data-playing="true"] .capsule-icon--pause { display: block; }

  .capsule-player__progress {
    position: absolute;
    right: 12px;
    bottom: 0;
    left: 12px;
    width: calc(100% - 24px);
    height: 8px;
    appearance: none;
    border: 1px solid rgb(14 42 71 / .55);
    border-radius: 48% 52% 45% 55%;
    background: linear-gradient(90deg, #ffb000 var(--audio-progress), rgb(14 42 71 / .08) var(--audio-progress));
    rotate: -.25deg;
    cursor: pointer;
  }
  .capsule-player__progress::-webkit-slider-runnable-track { height: 7px; border-radius: 48% 52%; background: transparent; }
  .capsule-player__progress::-webkit-slider-thumb { width: 11px; height: 13px; margin-top: -3px; appearance: none; border: 2px solid #fff9e8; border-radius: 47% 53%; background: #0e2a47; }
  .capsule-player__progress::-moz-range-track { height: 7px; background: transparent; }
  .capsule-player__progress::-moz-range-thumb { width: 9px; height: 9px; border: 3px solid #fff9e8; border-radius: 50%; background: #0e2a47; }

  @media (max-width: 639px) {
    .capsule-player { grid-template-columns: auto 1fr auto; }
    .capsule-player__copy p { display: none; }
  }
</style>
