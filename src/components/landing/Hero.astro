<section
  class="hero-sequence relative z-[1] h-[230svh] bg-page"
  data-tone="light"
  data-hero-sequence
  aria-labelledby="hero-title"
>
  <div
    class="hero-stage sticky top-0 flex h-svh flex-col justify-end overflow-hidden bg-page px-[var(--section-inline)] pt-24 pb-[clamp(24px,4vh,48px)]"
    data-hero-stage
  >
    <div
      class="font-hero-word pointer-events-none absolute top-[8vh] right-0 left-0 text-center text-[min(9.5vw,13vh)] leading-none text-navy max-md:top-[12vh] max-md:text-[18vw]"
      data-hero-in
      data-hero-word
      aria-hidden="true"
    >
      Simplixity
    </div>

    <div class="hero-cluster pointer-events-none absolute inset-[23vh_0_30vh] z-[2] flex items-center justify-center gap-[clamp(12px,2vw,34px)]">
      <figure
        class="hero-side-card relative z-[1] h-full max-h-[400px] w-[clamp(170px,17vw,280px)] rotate-[-4deg]"
        data-hero-side="left"
      >
        <div class="size-full overflow-hidden rounded-[20px] bg-lilac shadow-[0_24px_54px_rgba(14,42,71,.12)]">
          <img
            src="/media/landing/team/team-collaboration.webp"
            alt="Dos integrantes de Simplixity colaboran frente a una laptop en el estudio"
            width="972"
            height="1619"
            class="size-full object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
        <span class="hero-bubble hero-bubble--left absolute -bottom-4 -left-7 rounded-[16px] bg-[#FFD3E7] px-4 py-3 text-xl shadow-[0_6px_22px_rgba(14,42,71,.14)]" aria-hidden="true">🖥️ ⚡ 🎧</span>
      </figure>

      <figure
        class="hero-main-card relative z-[3] h-full max-h-[430px] w-[clamp(210px,21vw,330px)]"
        data-hero-main
        data-hero-in
      >
        <div class="hero-card-inner relative size-full" data-hero-card-inner>
          <div class="hero-card-face hero-card-front absolute inset-0 overflow-hidden rounded-[22px] bg-sage shadow-[0_30px_60px_rgba(14,42,71,.14)]">
            <img
              src="/media/landing/team/team-studio.webp"
              alt="El equipo de Simplixity reunido en el estudio"
              width="887"
              height="1774"
              class="size-full object-cover object-center"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <span class="hero-bubble hero-bubble--center absolute top-[18px] left-[18px] grid size-12 place-items-center rounded-[16px] bg-[#FFD3E7] text-xl shadow-[0_5px_18px_rgba(14,42,71,.12)]" aria-hidden="true">⚡</span>
          </div>

          <div class="hero-card-face hero-card-back absolute inset-0 overflow-hidden rounded-[22px] bg-navy shadow-[0_30px_60px_rgba(14,42,71,.2)]">
            <video
              class="size-full object-cover"
              src="/multimedia/reel.webm"
              muted
              loop
              playsinline
              preload="metadata"
              data-hero-reel
              aria-label="Showreel de proyectos creativos de Simplixity"
            ></video>
            <span class="hero-bubble hero-bubble--video absolute right-4 bottom-4 rounded-[16px] bg-[#FFD3E7] px-3.5 py-2.5 text-lg shadow-[0_5px_18px_rgba(14,42,71,.16)]" aria-hidden="true">🎬 ⚡</span>
          </div>
        </div>
      </figure>

      <figure
        class="hero-side-card relative z-[1] h-full max-h-[400px] w-[clamp(170px,17vw,280px)] rotate-[4deg]"
        data-hero-side="right"
      >
        <div class="size-full overflow-hidden rounded-[20px] bg-cyan shadow-[0_24px_54px_rgba(14,42,71,.12)]">
          <img
            src="/media/landing/team/team-review.webp"
            alt="Tres integrantes de Simplixity revisan ideas alrededor de una laptop"
            width="1003"
            height="1568"
            class="size-full object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
        <span class="hero-bubble hero-bubble--right absolute right-[-30px] -bottom-4 rounded-[16px] bg-[#FFD3E7] px-4 py-3 text-xl shadow-[0_6px_22px_rgba(14,42,71,.14)]" aria-hidden="true">🎥 ⚡ 👉</span>
      </figure>
    </div>

    <div class="relative z-[3] flex flex-wrap items-end justify-between gap-8">
      <div data-hero-in data-hero-copy>
        <p class="eyebrow mb-3.5 text-cyan">Agencia creativa de experiencias</p>
        <h1 id="hero-title" class="font-display m-0 text-[clamp(46px,6.6vw,108px)] leading-[.86] text-pink">
          Human<br /><span class="text-lilac">Tech Club</span>
        </h1>
      </div>

      <a
        href="/narrativas"
        class="interactive-lift flex w-[min(360px,100%)] gap-4 rounded-[22px] bg-navy p-[18px] text-white"
        data-hero-in
        data-hero-case
      >
        <div class="media-stripes grid h-[116px] w-24 shrink-0 place-items-center rounded-xl bg-[#1B3A5C] text-center">
          <span class="text-[9px] font-semibold text-muted">caso<br />16:9</span>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-[10px] font-semibold tracking-[.16em] text-cyan uppercase">Caso del mes</span>
          <strong class="font-display text-3xl leading-[.92]">Ruta<br />Eléctrica</strong>
          <div class="mt-1 flex flex-wrap gap-1.5 text-[11px]">
            <span class="rounded-full bg-pink px-2.5 py-1.5">Identidad</span>
            <span class="rounded-full bg-yellow px-2.5 py-1.5 text-navy">Campaña</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-card-inner {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .hero-card-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .hero-card-back {
    transform: rotateY(180deg);
  }

  .hero-main-card {
    perspective: 1500px;
    will-change: transform;
  }

  .hero-side-card,
  [data-hero-copy],
  [data-hero-case],
  [data-hero-word] {
    will-change: transform, opacity;
  }

  .hero-bubble {
    animation: bubble-float 3.8s cubic-bezier(.16, 1, .3, 1) infinite;
    white-space: nowrap;
  }

  .hero-bubble--right { animation-delay: -1.3s; }
  .hero-bubble--center { animation-delay: -.7s; }
  .hero-bubble--video { animation-delay: -2.1s; }

  @keyframes bubble-float {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-1deg); }
    50% { transform: translate3d(0, -8px, 0) rotate(1.5deg); }
  }

  @media (max-width: 767px) {
    .hero-sequence { height: 195svh; }
    .hero-cluster { inset: 25vh 0 42vh; }
    .hero-side-card { display: none; }
    .hero-main-card { width: min(58vw, 270px); max-height: 35vh; transform: rotate(-2deg); }
    .hero-bubble--center { top: 12px; left: 12px; }
  }

  @media (max-height: 720px) and (min-width: 768px) {
    .hero-cluster { inset: 20vh 0 25vh; }
    .hero-side-card { max-height: 300px; }
    .hero-main-card { max-height: 320px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-sequence { height: 100svh; }
    .hero-bubble { animation: none; }
  }
</style>
